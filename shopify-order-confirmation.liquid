        {% comment %} TWB — Spec Book: intake questionnaire link. Shows only when the order includes the Spec Book.
          Placement: in Settings → Notifications → Order confirmation, directly after the "Single Session Strategy Call"
          block's closing {% endfor %} and before {% assign transaction_count = transactions | size %}.
          The link carries only the order number (no name or email in the URL). {% endcomment %}
        {% for line in line_items %}
          {% if line.product.handle == 'healthy-home-spec-book' %}
            {% capture twb_intake_url %}https://specbook.thewellbuild.com/?order={{ order_name | remove: '#' | url_encode }}{% endcapture %}
            <table style="margin-top:24px; border-collapse:collapse; width:100%;">
              <tr>
                <td style="background:#FAF8F4; border:1px solid #C5D8CC; border-radius:8px; padding:24px; font-family:Helvetica,Arial,sans-serif;">

                  <p style="margin:0 0 8px; font-size:11px; letter-spacing:.15em; text-transform:uppercase; color:#B07D4A; font-weight:bold;">Next step</p>
                  <h2 style="margin:0 0 12px; font-family:Georgia,serif; color:#1E4430; font-size:20px;">Tell us about your project</h2>
                  <p style="margin:0 0 20px; font-size:14px; color:#3A3A3A; line-height:1.5;">
                    Your Spec Book starts with a short questionnaire (about 10 minutes) and a link to your drawings.
                    Your review begins once we have both, and typically arrives 7&ndash;10 business days after that.
                  </p>
                  <a href="{{ twb_intake_url }}" style="display:inline-block; background:#1E4430; color:#FEFDFB; padding:12px 22px; border-radius:8px; text-decoration:none; font-weight:600; font-size:15px;">
                    Start your intake &rarr;
                  </a>
                  <p style="margin:14px 0 0; font-size:13px; color:#6B6B6B;">
                    If the button doesn't work, go to <a href="{{ twb_intake_url }}" style="color:#1E4430;">specbook.thewellbuild.com</a>.
                  </p>

                </td>
              </tr>
            </table>
            {% break %}
          {% endif %}
        {% endfor %}
